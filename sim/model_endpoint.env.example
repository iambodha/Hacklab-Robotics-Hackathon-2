# Copy to sim/model_endpoint.env (ignored by git) and fill in. Used by run_agent_model.sh and the operator page.

# The /v1 root of the OpenAI-compatible endpoint. With a Cloudflare quick tunnel:
#   https://<random-words>.trycloudflare.com/v1
MODEL_BASE_URL=

# The model name exactly as the server lists it (bash sim/run_agent_model.sh --check prints the list).
# It must accept images: gemma3:4b / gemma3:12b / gemma3:27b do; gemma3:1b and text-only models do not.
MODEL_NAME=gemma3:12b

# Only if the endpoint asks for a key (Ollama and llama.cpp do not by default).
MODEL_API_KEY=

# json = the model replies with one JSON object per turn (works with Gemma). native = the endpoint's tools API.
MODEL_TOOL_MODE=json

# How many of the newest camera images stay in the model's context.
MODEL_KEEP_IMAGES=4

# --- On the computer that runs the model (for whoever sets it up) -------------------------------------------
# Ollama:      ollama pull gemma3:12b
#              OLLAMA_CONTEXT_LENGTH=16384 ollama serve          # the default context (4096) is too small
#              cloudflared tunnel --url http://localhost:11434 --http-host-header="localhost:11434"
#              (without --http-host-header Ollama answers 403 through the tunnel)
# llama.cpp:   llama-server -m gemma-3-12b-it.gguf --mmproj mmproj.gguf -c 16384 --port 8080
#              cloudflared tunnel --url http://localhost:8080
# LM Studio:   start the local server (port 1234), then cloudflared tunnel --url http://localhost:1234
# The tunnel prints https://<random-words>.trycloudflare.com : MODEL_BASE_URL is that address plus /v1
